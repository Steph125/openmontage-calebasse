c/chunks/2p1xtaazwoo-a.js?dpl=5-14-1\",\"/_next/static/chunks/3jdp6tqzgnwof.js?dpl=5-14-1\",\"/_next/static/chunks/0dz3ubkc4dmdh.js?dpl=5-14-1\",\"/_next/static/chunks/1o2ty50mcxokh.js?dpl=5-14-1\",\"/_next/static/chunks/2oz0u0jkxayr_.js?dpl=5-14-1\",\"/_next/static/chunks/1_fm3whdmuxrq.js?dpl=5-14-1\",\"/_next/static/chunks/2jzkroopf_wkl.js?dpl=5-14-1\",\"/_next/static/chunks/390puk-rzd2lf.js?dpl=5-14-1\",\"/_next/static/chunks/10uf1zbu-47-_.js?dpl=5-14-1\",\"/_next/static/chunks/2qn469mk3z1_x.js?dpl=5-14-1\",\"/_next/static/chunks/1i_2t6dfh3-9h.js?dpl=5-14-1\"],\"default\",1]\n58:T279c,\n  /* Header banner, Green Friday. Three dated banners, switched server-side (Paris time):\n     - until 06/11 18:00 and again from 09/11 00:01: the VIP line (links to #vip / #jeu of the Green Friday page);\n     - 06/11 18:00 -\u003e 09/11 00:01: the weekend offers, folded; « Voir les offres » opens 3 offer tiles + 2 \u003cvariant\u003e cards.\n     No script: the fold is a native \u003cdetails\u003e. Each banner has its own component-wrapper id. #FEF8EC ground. */\n  .c4935cf38 .component-wrapper {\n    position: relative;\n    overflow: hidden;\n    padding: 0;\n    margin: 0;\n    border-radius: 0.4rem;\n    background: #FEF8EC;\n    color: #1f4d2b;\n  }\n\n  .c4935cf38 .component-wrapper .component-wrapper-close-button {\n    top: 0;\n    right: 0;\n    width: 40px;\n    height: 40px;\n    padding: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: transparent;\n    border-radius: 50%;\n    box-shadow: none;\n  }\n\n  .c4935cf38 .component-wrapper .component-wrapper-close-button svg {\n    width: 14px;\n    height: 14px;\n    color: #1f4d2b;\n  }\n\n  .c4935cf38 .bandeau-bon {\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 2px;\n    padding: 16px 48px;\n    text-align: center;\n  }\n\n  .c4935cf38 .bandeau-bon p {\n    margin: 0;\n    padding: 0;\n    font-size: 15px;\n    line-height: 1.5;\n    color: #1f4d2b;\n    text-wrap: balance;\n  }\n\n  .c4935cf38 .bandeau-bon a {\n    font-weight: 700;\n    color: inherit;\n    text-decoration: underline;\n    text-underline-offset: 2px;\n  }\n\n  @media (max-width: 1023px) {\n    .c4935cf38 .bandeau-bon p {\n      font-size: 14px;\n      line-height: 1.35;\n    }\n  }\n\n  @media (max-width: 767px) {\n    .c4935cf38 .bandeau-bon {\n      padding: 14px 40px;\n    }\n  }\n\n  /* ---- weekend offers (06/11 18:00 -\u003e 09/11 00:01): a native \u003cdetails\u003e, the summary is the CTA ---- */\n  .c4935cf38 .bandeau-we {\n    box-sizing: border-box;\n    padding: 12px 24px;\n    color: #1f4d2b;\n  }\n\n  .c4935cf38 .bandeau-we \u003e summary {\n    list-style: none;\n    cursor: pointer;\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: center;\n    gap: 6px 12px;\n    padding: 0 28px;\n    font-size: 15px;\n    line-height: 1.4;\n    text-align: center;\n  }\n\n  .c4935cf38 .bandeau-we \u003e summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .c4935cf38 .bandeau-we-cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    padding: 5px 14px;\n    border-radius: 999px;\n    background: #1f4d2b;\n    color: #FEF8EC;\n    font-size: 13px;\n    font-weight: 600;\n    white-space: nowrap;\n  }\n\n  .c4935cf38 .bandeau-we-cta svg {\n    transition: transform 0.2s;\n  }\n\n  .c4935cf38 .bandeau-we[open] .bandeau-we-cta svg {\n    transform: rotate(180deg);\n  }\n\n  .c4935cf38 .bandeau-we .bandeau-we-ferme,\n  .c4935cf38 .bandeau-we[open] .bandeau-we-voir {\n    display: none;\n  }\n\n  .c4935cf38 .bandeau-we[open] .bandeau-we-ferme {\n    display: inline;\n  }\n\n  .c4935cf38 .bandeau-we-body {\n    max-width: 960px;\n    margin: 14px auto 4px;\n    text-align: center;\n  }\n\n  /* the three offers: one row of three tiles on a pale green ground (quieter than the white product cards below),\n     each a single link. Behind the text: a big faint step number, the offer's icon in the bottom-right corner and a\n     small accent (sparkles / leaf) top-right, all from the « accents promotionnels végétaux » sheet.\n     Phones: three horizontal strips, same layering. */\n  .c4935cf38 .bandeau-we-tiles {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .c4935cf38 .bandeau-we-tile {\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    min-height: 116px;\n    padding: 16px 84px 16px 22px;\n    border: 1px solid #DDE8C6;\n    border-radius: 14px;\n    background: #F2F6E6;\n    color: #1f4d2b;\n    font-size: 14px;\n    line-height: 1.4;\n    text-align: left;\n    text-decoration: none;\n    text-wrap: pretty;\n    transition: border-color 0.2s;\n  }\n\n  .c4935cf38 .bandeau-we-tile:hover {\n    opacity: 1;\n    border-color: #A9C47F;\n  }\n\n  .c4935cf38 .bandeau-we-num {\n    position: absolute;\n    /* glyph pressed into the top-left corner, ~3px cut on each side: Poppins 800 digits start ~0.11em below\n       the box top and ~0.02em right of its left edge (measured), so the offsets scale with the font size */\n    left: calc(-0.02em - 3px);\n    top: calc(-0.11em - 3px);\n    font-size: 84px;\n    font-weight: 800;\n    line-height: 1;\n    color: #1f4d2b;\n    opacity: 0.08;\n    pointer-events: none;\n  }\n\n  .c4935cf38 .bandeau-we-ico {\n    position: absolute;\n    right: -6px;\n    bottom: -8px;\n    width: 88px;\n    height: 74px;\n    -o-object-fit: contain;\n    object-fit: contain;\n    opacity: 0.6;\n    transform: rotate(-8deg);\n    pointer-events: none;\n  }\n\n  .c4935cf38 .bandeau-we-tile:nth-child(2) .bandeau-we-ico {\n    transform: rotate(6deg);\n  }\n\n  .c4935cf38 .bandeau-we-tile:nth-child(3) .bandeau-we-ico {\n    right: -10px;\n    bottom: -4px;\n    transform: rotate(-14deg);\n  }\n\n  .c4935cf38 .bandeau-we-deco {\n    position: absolute;\n    top: 8px;\n    right: 14px;\n    width: 26px;\n    height: 28px;\n    -o-object-fit: contain;\n    object-fit: contain;\n    opacity: 0.55;\n    pointer-events: none;\n  }\n\n  .c4935cf38 .bandeau-we-tile:nth-child(2) .bandeau-we-deco {\n    width: 30px;\n    height: 30px;\n    transform: rotate(-24deg);\n  }\n\n  .c4935cf38 .bandeau-we-txt {\n    position: relative;\n  }\n\n  .c4935cf38 .bandeau-we-tile b {\n    font-weight: 700;\n    text-decoration: underline;\n    text-underline-offset: 2px;\n  }\n\n  .c4935cf38 .bandeau-we-k {\n    margin: 14px 0 10px;\n    padding: 0;\n    font-size: 15px;\n    font-weight: 700;\n  }\n\n  .c4935cf38 .bandeau-we-cards {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  /* hand-built cards from \u003cvariant\u003e parts (no \u003cproduct-card\u003e look): square packshot | name, format, price + add to cart.\n     \u003cvariant\u003e leaves no element behind, so its parts are direct children of .bandeau-we-card */\n  .c4935cf38 .bandeau-we-card {\n    display: grid;\n    grid-template-columns: 84px minmax(0, 1fr);\n    gap: 12px;\n    align-items: center;\n    padding: 12px;\n    text-align: left;\n    border: 1px solid #F0E3C4;\n    border-radius: 14px;\n    background: #FFFFFF;\n  }\n\n  .c4935cf38 .bandeau-we-card a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  .c4935cf38 .bandeau-we-card a:hover {\n    opacity: 1;\n  }\n\n  .c4935cf38 .bandeau-we-card .variant-image-container {\n    width: 84px;\n    height: 84px;\n    border-radius: 10px;\n    background: #FEFDF8;\n  }\n\n  .c4935cf38 .bandeau-we-card .variant-image {\n    width: 100%;\n    height: 100%;\n    -o-object-fit: contain;\n    object-fit: contain;\n  }\n\n  .c4935cf38 .bandeau-we-info {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n    min-width: 0;\n  }\n\n  .c4935cf38 .bandeau-we-card .variant-title {\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n    overflow: hidden;\n    min-height: 2.6em;  /* always two lines tall, one-line names included */\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.3;\n    color: #1f4d2b;\n    text-align: left;\n  }\n\n  .c4935cf38 .bandeau-we-card .variant-subtitle {\n    overflow: hidden;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    font-size: 12px;\n    line-height: 1.3;\n    color: #6B6B5E;\n    text-align: left;\n  }\n\n  .c4935cf38 .bandeau-we-buy {\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 6px;\n    margin-top: 4px;\n  }\n\n  .c4935cf38 .bandeau-we-prix {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    min-height: 24px;\n    white-space: nowrap;\n  }\n\n  .c4935cf38 .bandeau-we-card .variant-price {\n    font-size: 15px;\n    font-weight: 700;\n    color: #1f4d2b;\n  }\n\n  .c4935cf38 .bandeau-we-card .variant-price-base {\n    font-size: 12px;\n    font-weight: 400;\n    color: #8A8A7A;\n  }\n\n  .c4935cf38 .bandeau-we-card .variant-discount {\n    padding: 1px 7px;\n    font-size: 12px;\n    line-height: 1.5;\n  }\n\n  .c4935cf38 .bandeau-we-card .variant-add-to-cart-button {\n    width: 100%;\n    height: 32px;\n    padding: 0 14px;\n    border-radius: 999px;\n    background: #1f4d2b;\n    color: #FEF8EC;\n    font-size: 13px;\n    font-weight: 600;\n  }\n\n  @media (max-width: 1023px) {\n    .c4935cf38 .bandeau-we \u003e summary,\n    .c4935cf38 .bandeau-we-k {\n      font-size: 14px;\n    }\n\n    .c4935cf38 .bandeau-we-tile {\n      min-height: 104px;\n      padding: 14px 60px 14px 16px;\n      font-size: 13px;\n    }\n\n    .c4935cf38 .bandeau-we-ico,\n    .c4935cf38 .bandeau-we-tile:nth-child(3) .bandeau-we-ico {\n      right: -10px;\n      bottom: -10px;\n      width: 72px;\n      height: 60px;\n    }\n\n    .c4935cf38 .bandeau-we-deco {\n      right: 10px;\n      width: 20px;\n      height: 22px;\n    }\n\n    .c4935cf38 .bandeau-we-num {\n      font-size: 68px;\n    }\n  }\n\n  @media (max-width: 767px) {\n    .c4935cf38 .bandeau-we {\n      padding: 12px 16px;\n    }\n\n    .c4935cf38 .bandeau-we-cards,\n    .c4935cf38 .bandeau-we-tiles {\n      grid-template-columns: 1fr;\n      max-width: 360px;\n      margin: 0 auto;\n    }\n\n    .c4935cf38 .bandeau-we-tiles {\n      gap: 8px;\n    }\n\n    .c4935cf38 .bandeau-we-tile {\n      min-height: 72px;\n      padding: 12px 80px 12px 18px;\n    }\n\n    .c4935cf38 .bandeau-we-num {\n      font-size: 64px;\n    }\n\n    .c4935cf38 .bandeau-we-ico,\n    .c4935cf38 .bandeau-we-tile:nth-child(3) .bandeau-we-ico {\n      right: -4px;\n      bottom: -10px;\n      width: 78px;\n      height: 64px;\n    }\n\n    .c4935cf38 .bandeau-we-deco {\n      top: 6px;\n      right: 70px;\n      width: 20px;\n      height: 22px;\n    }\n\n    .c4935cf38 .bandeau-we-card {\n      grid-template-columns: 76px minmax(0, 1fr);\n    }\n\n    .c4935cf38 .bandeau-we-card .variant-image-container {\n      width: 76px;\n      height: 76px;\n    }\n\n    .c4935cf38 .bandeau-we-card .variant-price {\n      font-size: 14px;\n    }\n\n    .c4935cf38 .bandeau-we-card .variant-price-base,\n    .c4935cf38 .bandeau-we-card .variant-discount {\n      font-size: 11px;\n    }\n  }\n26:[\"$\",\"$L57\",null,{\"content\":{\"fetchedData\":{},\"html\":\"\u003cdiv class=\\\"c4935cf38 caleverte-markdown\\\"\u003e\\n      \\n\\n\\n\\n\\n\\n\u003cbanner schedule-from=\\\"2026-11-23T15:00\\\" schedule-to=\\\"2026-11-24T10:00\\\"\u003e\\n  \u003ccomponent-wrapper id=\\\"page-header-green-friday-vip\\\" close=\\\"manual\\\" openmode=\\\"timed\\\" ttlhours=\\\"24\\\"\u003e\\n    \u003ccontent\u003e\\n      \u003cdiv class=\\\"bandeau-bon\\\"\u003e\\n        \u003cp\u003eDès 69€, un sachet de \u003ca class=\\\"gtmtrack\\\" content-content=\\\"bandeau-gf-puer\\\" href=\\\"https://calebasse.com/produits/pu-er-huang-the-puer-jaune-3890\\\"\u003eThé Puer jaune\u003c/a\u003e offert avec le code : \u003cb\u003ePUER69\u003c/b