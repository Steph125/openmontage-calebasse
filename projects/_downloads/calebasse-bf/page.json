,"5f:T2246,/* Menu Calebasse : le menu de la prod (relevé du 28/10/2026) repris dans le format tête + panneau.\n   Toutes les règles sont préfixées automatiquement par [data-layer=menu] : ne pas l'écrire ici.\n   Notes : menu-refonte/menu-dev-reprise-prod/NOTES.md */\n\n/* Enveloppe posée par le front autour de chaque fragment : neutre pour la mise en page. */\n[data-layer=menu] .cms-menu { display: contents; }\n\n/* --- Têtes -------------------------------------------------------------- */\n[data-layer=menu] .menu-head-link {\n  --menu-link-color: var(--color-gray-500, #6a7282);\n  --menu-promo-color: var(--color-green-600, #00a544);\n  --menu-brand-color: var(--color-primary, #aacb55);\n  display: flex;\n  align-items: center;\n  padding: 0 1rem;\n  color: var(--menu-link-color);\n  text-align: center;\n}\n[data-layer=menu] .menu-head-link:hover { text-decoration: none; }\n/* Temps forts (À la une, Anniversaire, Automne, Recettes) : vert, gras, fixes au survol. */\n[data-layer=menu] .menu-head-link.is-promo { color: var(--menu-promo-color); font-weight: 700; }\n/* Entrées de marque (Blog, feuille) : couleur de marque, graisse normale. */\n[data-layer=menu] .menu-head-link.is-highlighted { color: var(--menu-brand-color); }\n[data-layer=menu] .menu-head-link svg { width: 1rem; height: 1rem; }\n[data-layer=menu] .gtmtrack * { pointer-events: none; }\n\n/* Une tête qui ne contient que ce marqueur masque son élément (Blog en en et zh). */\n[data-layer=menu] .desktop-menu-item:has(.menu-hidden),\n[data-layer=menu] .mobile-menu-item:has(.menu-hidden) { display: none; }\n\n/* Sous-menu court, écrit dans la tête : invisible hors desktop. */\n[data-layer=menu] .pm-drop { display: none; }\n\n/* --- Desktop ------------------------------------------------------------ */\n@media (min-width: 1024px) {\n  /* Entrée survolée ou ouverte : couleur de marque, sauf les temps forts.\n     :focus-visible et non :focus-within : après un clic, le lien garde le focus. */\n  [data-layer=menu] .desktop-menu-item:hover .menu-head-link:not(.is-promo),\n  [data-layer=menu] .desktop-menu-item:has(:focus-visible) .menu-head-link:not(.is-promo),\n  [data-layer=menu] .desktop-menu-item.is-open .menu-head-link:not(.is-promo) { color: var(--menu-brand-color); }\n\n  /* Le front ouvre chaque panneau dans une bande pleine largeur : on la rend transparente,\n     la carte blanche est dessinée dans le panneau lui-même. */\n  [data-layer=menu] #desktop-menu .accordion-content { background: transparent; box-shadow: none; }\n  /* Panneaux réservés au mobile : leur bande ne s'ouvre pas sur desktop. */\n  [data-layer=menu] #desktop-menu .accordion-content:has(.pm-mobile-only) { display: none; }\n\n  /* Grand panneau (Santé) : carte de la largeur du menu, groupes en colonnes. */\n  [data-layer=menu] .pm-mega {\n    width: min(1280px, calc(100% - 140px));\n    max-width: none;\n    margin: 0 auto 1rem;\n    padding: 0;\n    background: #fff;\n    border-radius: 0.875rem;\n    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);\n  }\n  [data-layer=menu] .pm-mega .mega-menu-groups {\n    display: flex;\n    flex-direction: column;\n    flex-wrap: wrap;\n    gap: 2rem;\n    max-height: 60vh;\n    overflow: auto;\n    margin: 0;\n    padding: 3rem;\n    list-style: none;\n  }\n  [data-layer=menu] .pm-mega li { margin: 0; }\n  [data-layer=menu] .pm-mega summary { display: block; list-style: none; cursor: default; }\n  [data-layer=menu] .pm-mega summary::-webkit-details-marker { display: none; }\n  [data-layer=menu] .pm-mega details::details-content { content-visibility: visible; }\n  [data-layer=menu] .pm-mega .mega-menu-group-title { color: var(--color-green-700, #008236); font-size: 1.25rem; line-height: 1.75rem; }\n  [data-layer=menu] .pm-mega .mega-menu-group-items { display: flex; flex-direction: column; gap: 1rem; margin: 1.5rem 0; padding: 0; list-style: none; }\n  [data-layer=menu] .pm-mega a { font-weight: 400; }\n  [data-layer=menu] .pm-mega a:hover { text-decoration: underline; }\n\n  /* Sous-menu court (Plantes et mélanges, Matériel MTC, Livres, feuille) : carte sous l'entrée. */\n  [data-layer=menu] .desktop-menu-item:has(.pm-drop) { position: relative; }\n  [data-layer=menu] .desktop-menu-item .pm-drop {\n    display: block;\n    visibility: hidden;\n    transform: scaleY(0);\n    transform-origin: top;\n    position: absolute;\n    top: 100%;\n    left: calc(50% - 7rem);\n    z-index: 50;\n    width: 13rem;\n    padding: 2rem;\n    background: #fff;\n    border-radius: 0.875rem;\n    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);\n    text-align: left;\n  }\n  /* Ouverte par l'état du front (is-open, retiré à la navigation), comme le grand panneau ;\n     pas par :hover, qui reste vrai si la souris n'a pas bougé après le clic. */\n  [data-layer=menu] .desktop-menu-item.is-open .pm-drop,\n  [data-layer=menu] .desktop-menu-item:has(:focus-visible) .pm-drop {\n    visibility: visible;\n    transform: scaleY(1);\n    transition: transform 0.2s ease-in-out;\n  }\n  [data-layer=menu] .pm-drop .mega-menu-groups { display: flex; flex-direction: column; gap: 2rem; max-height: 60vh; margin: 0; padding: 0; list-style: none; }\n  [data-layer=menu] .pm-drop li { margin: 0; }\n  [data-layer=menu] .pm-drop a { color: inherit; font-weight: 400; }\n  [data-layer=menu] .pm-drop a:hover { text-decoration: underline; }\n}\n\n/* --- Mobile : accordéons imbriqués ---------------------------------------- */\n@media (max-width: 1023.98px) {\n  [data-layer=menu] .mobile-menu-item .menu-head-link { padding: 0; color: inherit; text-align: left; }\n  [data-layer=menu] .mobile-menu-item .menu-head-link.is-promo { color: var(--menu-promo-color); }\n  [data-layer=menu] .mobile-menu-item .menu-head-link.is-highlighted,\n  [data-layer=menu] .mobile-menu-item.is-open .menu-head-link:not(.is-promo) { color: var(--menu-brand-color); }\n\n  [data-layer=menu] .mega-menu { max-width: none; padding: 0; }\n  [data-layer=menu] .mega-menu-groups,\n  [data-layer=menu] .mega-me